# Copy this file to .env and fill in real values before starting.
#
# Generate secrets:
#   openssl rand -hex 32   → SECRET_KEY
#   openssl rand -hex 64   → JWT_SECRET
#   openssl rand -hex 32   → POSTGRES_PASSWORD

# ── Required ──────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
SECRET_KEY=
# REQUIRED — generate with: openssl rand -hex 64
JWT_SECRET=

# OPTIONAL — separates data-at-rest encryption (IMAP passwords, SSO refresh
# tokens, encrypted Admin > Settings values) from SECRET_KEY, which also signs
# JWTs. Empty = falls back to deriving the key from SECRET_KEY (still works,
# just coupled). Generate with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# ── Database ───────────────────────────────────────────────────────────────────
# Required for Docker Compose — used as the PostgreSQL password.
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=

# DATABASE_URL is set automatically by docker-compose.yml.
# Override here only for local development outside Docker.
# PostgreSQL (local dev / production / custom):
#   DATABASE_URL=postgresql+asyncpg://portal:<password>@localhost:5432/portal

# ── Timezone ──────────────────────────────────────────────────────────────────
# Timezone for shift times configured in the admin panel.
# Users receive notifications converted to their own profile timezone.
# Any IANA name: UTC, Europe/Moscow, Asia/Dubai, Europe/Berlin, etc.
PORTAL_TIMEZONE=UTC

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local dev the default (localhost) is fine.
# For VPS/production, add your domain, e.g.:
#   CORS_ORIGINS=https://portal.example.com
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# In production, set ENVIRONMENT=production and update CORS_ORIGINS:
# CORS_ORIGINS=https://your-portal.example.com
ENVIRONMENT=development

# ── Telegram Bot (optional) ───────────────────────────────────────────────────
# Create a bot via @BotFather and paste the token here.
# Leave empty to disable all Telegram functionality.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Zammad (optional) ────────────────────────────────────────────────────────
# HMAC SHA1 token configured in Zammad Admin -> Webhook.
ZAMMAD_WEBHOOK_SECRET=
# Base Zammad URL, e.g. https://tickets.example.com.
ZAMMAD_URL=
# API token used to import active tickets on backend startup.
ZAMMAD_API_TOKEN=
# Set false to disable startup import of active Zammad tickets.
ZAMMAD_SYNC_ON_STARTUP=true

# ── Mail Reporter (optional) ──────────────────────────────────────────────────
# IMAP server settings — defaults work for Yandex 360.
# MAIL_IMAP_SERVER=imap.yandex.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_TIMEOUT=30
# How often (seconds) to poll all enabled mailboxes (default: 30).
# MAIL_POLL_INTERVAL=30
# Fallback Telegram chat_id when a mailbox has no telegram_target configured.
MAIL_DEFAULT_CHAT_ID=
# Fallback thread/topic id inside that chat (leave empty if not using forum topics).
MAIL_DEFAULT_THREAD_ID=

# Mailbox Backup tool (Tools section) — Yandex Object Storage (S3). Empty = tool hidden.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_STORAGE_CLASS=GLACIER
S3_PREFIX=Backups/Yandex Mailboxes
MAILBOX_BACKUP_IMAP_HOST=imap.yandex.ru
MAILBOX_BACKUP_ZSTD_LEVEL=10

# Inventory tool (Tools section) — browse/create/edit (never delete) devices in NetBox. Empty = section hidden.
NETBOX_URL=
NETBOX_API_TOKEN=
# Handover PDF generator (Tools section) — works without NetBox.
HANDOVER_ASSIGNOR_NAME=Darpo FZ LLC (DBA Viory)

# Service Status board — Prometheus remote_write ingestion (/api/status/remote-write).
# Mandatory: with no token set the endpoint refuses all writes.
PROMETHEUS_REMOTE_WRITE_TOKEN=   # openssl rand -hex 32
STATUS_STALE_AFTER_SECONDS=180   # newest sample older than this = target shown as stale
STATUS_PRUNE_AFTER_HOURS=24      # drop targets Prometheus stopped pushing
STATUS_GROUP_LABEL=job           # label whose value groups targets into sections
